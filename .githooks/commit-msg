#!/bin/sh
# Enforce Conventional Commits: <type>(<scope>)?!?: <subject>
# Enabled per clone with: git config core.hooksPath .githooks
set -e

message_file="$1"
header=$(head -n 1 "$message_file")

# Merge and fixup commits are generated by git, not authored by hand.
case "$header" in
  "Merge "*|"fixup! "*|"squash! "*|"amend! "*)
    exit 0
    ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9 ._-]+\))?!?: .+'

if ! printf '%s' "$header" | grep -Eq "$pattern"; then
  printf '\n  Commit message does not follow Conventional Commits.\n\n' >&2
  printf '  Got:      %s\n' "$header" >&2
  printf '  Expected: <type>(<scope>)?: <subject>\n' >&2
  printf '  Types:    feat fix docs style refactor perf test build ci chore revert\n' >&2
  printf '  Example:  feat(panel): show the attached chat title\n\n' >&2
  exit 1
fi

if [ "${#header}" -gt 100 ]; then
  printf '\n  Commit header is %s characters; keep it at 100 or fewer.\n\n' "${#header}" >&2
  exit 1
fi
